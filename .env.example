# Server
PORT=8080

# CTA GTFS static (schedule)
CTA_STATIC_URL=https://www.transitchicago.com/downloads/sch_data/google_transit.zip

# CTA GTFS-Realtime (requires an API key)
CTA_TU_URL=https://transitdata.transitchicago.com/GtfsRealtime/TripUpdates.pb
CTA_VP_URL=https://transitdata.transitchicago.com/GtfsRealtime/VehiclePositions.pb

# Required — get one free at https://www.transitchicago.com/developers/
# Put your real key in .env (gitignored); never commit it.
CTA_API_KEY=

# Storage
DB_PATH=./data/dispatch.db
STATIC_GTFS_PATH=./data/gtfs.zip

# Geometry-based arrival/departure detection (optional; defaults shown, editable
# at runtime via PUT /api/config or the Settings page):
#   arrivalRadiusMeters=150           # soft arm radius around a terminal stop
#   terminalMovementMeters=75         # extra tolerance so a bus can inch within the terminal
#   stationaryDisplacementMeters=20   # displacement/poll that counts as parked
#   confirmPings=2                    # consecutive parked polls to commit an arm
#   departPings=2                     # consecutive moving/outside polls to commit departure
#   scheduleArmGraceSeconds=120       # scheduled-arm fallback grace after scheduled arrival
